article {
    h1, h2, h3, h4, h5, h6, p, blockquote, ul, ol, dl, figure, .highlight {
        margin-bottom: 0.2em;
        font-weight: normal;
    }
    blockquote {
      background: #fbf4e6;
      padding: 10px 20px;
    }
    p {
        // text-indent: 2em;
        text-align: justify !important;
        margin-bottom: 1em;
    }
    question {
        font-size: 0.8em;
        color: red;
    }
    .post-title {
        .title {
            font-size: 1.8em;
            font-weight: 500;
        }
    }
    .post-meta {
        color: #828282;
        margin-bottom: 20px;
    }
    .post-content {
        .highlight {
        background: #f7f7f7;
        margin: 20px 0;
        padding: 15px;
        overflow: auto;
        font-size: $code-font-size;
        line-height: $line-height-code-block;
        .gutter {
            width: 30px;
        }
        figcaption {
            font-size: 0.85em;
            color: #8e908c;
            line-height: 1em;
            margin-bottom: 1em;
        }
        figcaption a {
            float: right;
        }
        .gutter pre {
            text-align: right;
            padding-right: 20px;
        }
        .line {
            height: 20px;
        }
        pre .comment {
            color: #8e908c;
        }
        pre .variable,
        pre .attribute,
        pre .tag,
        pre .regexp,
        pre .ruby .constant,
        pre .xml .tag .title,
        pre .xml .pi,
        pre .xml .doctype,
        pre .html .doctype,
        pre .css .id,
        pre .css .class,
        pre .css .pseudo {
        color: #c82829;
        }
        pre .number,
        pre .preprocessor,
        pre .built_in,
        pre .literal,
        pre .params,
        pre .constant,
        pre .command {
        color: #f5871f;
        }
        pre .ruby .class .title,
        pre .css .rules .attribute {
        color: #718c00;
        }
        pre .string,
        pre .value,
        pre .inheritance,
        pre .header,
        pre .ruby .symbol,
        pre .xml .cdata,
        pre .special,
        pre .number,
        pre .formula {
        color: #718c00;
        }
        pre .title,
        pre .css .hexcolor {
        color: #3e999f;
        }
        pre .function,
        pre .python .decorator,
        pre .python .title,
        pre .ruby .function .title,
        pre .ruby .title .keyword,
        pre .perl .sub,
        pre .javascript .title,
        pre .coffeescript .title {
        color: #4271ae;
        }
        pre .keyword,
        pre .javascript .function {
        color: #8959a8;
        }
        }
        a {
            text-decoration: none;
            cursor: crosshair;
            border-bottom: 1px dashed Red;
            color: #00f;
        }
        h1 {
            font-size: 1.5em;
            border-bottom: 1px solid black;
        }
        h2 {
            font-size: 1.4em;
            border-bottom: 1px solid black;
        }
        h3 {
            font-size: 1.3em;
            border-bottom: 1px solid black;
        }
        h4 {
            font-weight: 600;
            font-size: 1.2em;
            // text-decoration: underline;
            border-bottom: 1px solid black;
        }
        h5 {
            font-size: 1.1em;
        }
        .headerlink {
            width: 10px;    
        }
        .line {
            font-family: $content-font;
            }
        > table {
            border-collapse: collapse;
            border-spacing: 0;
            thead {
                th {
                    padding: 6px 13px;
                    border: 1px solid #dfe2e5;
                }
            }
            tbody {
                td {
                    padding: 6px 13px;
                    border: 1px solid #dfe2e5;
                } 
            }
            tr:nth-child(2n) {
                background-color: #f6f8fa;
            }
        }
    }
}