/**
*定义变量
*
**/
$base-font-family = Helvetica, Arial, FreeSans, sans-serif;
$base-font-size = 16px;
$small-font-size = $base-font-size * 0.875;
$base-line-height = 1.8;
$letter-spacing = 0.5px;
$spacing-unit = 30px;
$text-color = #111;
$background-color = #fdfdfd;
$brand-color = #2a7ae2;
$grey-color = #828282;
$grey-color-light = lighten($grey-color, 40%);
$grey-color-dark = darken($grey-color, 25%);
$on-palm = 600px;
$on-laptop = 800px;
//quote
$content-font = 'Roboto', sans-serif;
//blog title
$title-font = 'Permanent Marker', cursive;
//main content
$other-font = 'Lato', sans-serif;
/**
 *
 * 消除浏览器样式
 *
* */
html {
  color: #000;
  background: #FFF;
  font-family: $other-font;
}

body, div, dl, dt, dd, ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, fieldset, input, textarea, p, blockquote, th, td {
  margin: 0;
  padding: 0;
}

p {
  font-family: $content-font;
}

table {
  border-collapse: collapse;
  border-spacing: 0;
}

fieldset, img {
  border: 0;
}

address, caption, cite, code, dfn, em, strong, th, var {
  font-style: normal;
  font-weight: normal;
}

ol, ul {
  //list-style: none;
}

caption, th {
  text-align: left;
}

h1, h2, h3, h4, h5, h6 {
  font-size: 100%;
  font-weight: normal;
}

q:before, q:after {
  content: '';
}

abbr, acronym {
  border: 0;
}

@charset 'utf-8'
* {
  margin: 0px;
  padding: 0px;
}

a {
  text-decoration: none;
  color: #000000;
  /* 字体 */
}

li {
  list-style: none;
}

input, img {
  display: block;
  box-shadow: 0 0 10px #555;
  border-radius: 6px;
  margin-left: auto;
  margin-right: auto;
  margin-top: 10px;
  margin-bottom: 10px;
  -webkit-box-shadow: 0 0 10px #555;
  width: 100%;
}

body {
  background-color white
  font-size 16px
  line-height 1.5
}

.container {
  max-width 960px
  margin 0 auto
}

.main {
  padding: 20px;
  max-width: calc(800px - (30px * 2))
  margin: 0 auto
}

@import '_partial/header';
@import '_partial/post';
@import '_partial/paginator'